# رابط قاعدة البيانات (Neon أو Railway أو Supabase)
DATABASE_URL=postgresql://user:password@host/dbname
# للتجربة على ذاكرة مؤقتة فقط: USE_LOCAL_DB=true مع npm run dev.
# لا يُسمح بهذا الخيار في الإنتاج؛ بيانات التجربة تزول بإيقاف العملية.
# على Railway يغيّر التطبيق اسم القاعدة تلقائيًا إلى aqlan_center_mini_v2 داخل
# خدمة PostgreSQL التابعة لمشروع Aqlan Center Mini، ولا يلمس قاعدة railway القديمة.

# ── (P1-FIX-8) تصنيف بيئة الهدف — إلزامي لأدوات قاعدة البيانات ────────────────
# db:migrate --apply وrestore:full ترفضان بنيويًّا production وunknown-remote؛
# التصنيف الصريح هو ما يفتح القواعد البعيدة غير الإنتاجية (اختبار/تدريج):
#   test | development | staging | production
# غيابه مع مضيف بعيد = unknown-remote ⇒ رفض أي كتابة حتى يُصنَّف.
# DATABASE_ENVIRONMENT=development

# توقيت العيادة — تعز/اليمن. يُترك كما هو إلا عند تغيير المدينة.
CLINIC_TIME_ZONE=Asia/Aden

# عدد الكراسي واسم المركز وأسعار الصرف تُضبط من شاشة /settings لا من هنا.

# سرّ توقيع الجلسات — 32 حرفًا فأكثر. ولّده بأمر:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# رمز الإعداد الأول — يُستخدم مرة واحدة لإنشاء حساب المدير، ثم احذفه من إعدادات النشر.
SETUP_TOKEN=

# مجلّد الأشعة والمستندات — **يجب أن يكون داخل قرص دائم موثَّق** (P1-FIX-7 + P1-FINAL-4).
#
# على Railway: أضف Volume إلى الخدمة وركّبه على /data — توفّر Railway تلقائيًّا
# RAILWAY_VOLUME_MOUNT_PATH=/data (المصدر الـauthoritative لوجود القرص)،
# ثم اضبط:
#   DOCUMENTS_DIR=/data/documents
# يجب أن يكون DOCUMENTS_DIR داخل نقطة تركيب القرص (path.relative)؛ الدليل
# الوحيد الكافي داخل Railway هو متغير المنصة هذا (أو قرص مثبت فعلًا يظهر في
# /proc/mounts حين تغيب سلة المنصة). DURABLE_STORAGE_ROOT مخالف له لا يفتح
# بابًا داخل Railway. مسار مطلق «عادي» داخل الحاوية بلا قرص = غير دائم: يُمحى
# عند أول إعادة نشر — ولذلك يُرفض.
#
# خارج Railway: وثّق الجذر الدائم صريحًا بـDURABLE_STORAGE_ROOT واحتوِ
# DOCUMENTS_DIR داخله.
#
# محليًّا: ./.data/documents (بلا سياق إنتاج يُقبل المسار المطلق خارج المناطق المؤقّتة)
DOCUMENTS_DIR=
# DURABLE_STORAGE_ROOT=/data

# مفتاح Google Gemini API للذكاء الاصطناعي (احصل عليه من Google AI Studio)
GEMINI_API_KEY=

# ── (P1) تحصين قاعدة البيانات ────────────────────────────────────────────────

# شهادة الجذر للتحقق الكامل من سلسلة شهادة PostgreSQL (P1.19 + P1-FIX-9).
# احصل على شهادة جذر تثق بها (من مزوّد القاعدة أو من مسؤول البنية)، ارفعها
# للخدمة واضبط مسارها هنا — فيتحول الاتصال من «مشفَّر بلا تحقق» إلى «مشفَّر
# ومتحقَّق». ملاحظة صدق: لم نتحقق أن Railway يتيح تنزيل CA من لوحة قاعدة
# PostgreSQL — لا تفترض ذلك؛ وإن جربته فوثّق النتيجة فعلًا.
# سياسة P1: sslmode=disable على مضيف بعيد في سياق إنتاج = رفض فوري (الإقلاع
# يفشل بصوت عالٍ). بلا هذا المتغير يبقى البعيد «مشفَّرًا بلا تحقق» — مخاطرة
# متبقية معلنة مع تحذير مسجَّل عند الإقلاع، لا تُسمّى verified.
# PGSSL_ROOT_CERT=/path/to/ca.pem

# سقف اتصالات الـpool (P1.20) — 1 إلى 20، والافتراضي 3.
# DB_POOL_MAX=3

# ── (P1) اختبارات تكامل PostgreSQL الحقيقية (لا تُضبط في الإنتاج) ────────────
# قاعدة معزولة لأمر npm run test:postgres — لا توجَّه لقاعدة إنتاج أبدًا.
# TEST_DATABASE_URL=postgresql://ci@127.0.0.1:5432/aqlan_p1_test?sslmode=disable

# ── (P2) أمن طبقة التطبيق/HTTP ───────────────────────────────────────────────

# قائمة المضيفين الموثوقين (فواصل) — ترويسات Host/X-Forwarded-Host يكتبها
# العميل، فلا يُبنى منها رابط مطلق ولا يُقبل Origin إلا إذا طابقت هذه القائمة
# أو أصل الطلب نفسه. (P0.15 أصلًا + P2/S4 لحارس الـmutations.)
# TRUSTED_HOSTS=aqlan-center-mini.up.railway.app

# المضيفات المسموح لمزودي الذكاء الاصطناعي المخصصين في الإنتاج (فواصل).
# الإنتاج يقبل HTTPS فقط وبمضيف من القائمة المدمجة (api.openai.com وapi.z.ai
# وapi.deepseek.com وapi.anthropic.com وgenerativelanguage.googleapis.com
# وapi.groq.com) أو من هذه القائمة الصريحة — لا مضيف اعتباطي. SSRF محجوب:
# localhost وRFC1918 وlink-local وmetadata endpoints والمدى الخاص لIPv6.
# AI_PROVIDER_ALLOWED_HOSTS=

# حدود أجسام الطلبات (كيلوبايت) — قابلة للتهيئة، والافتراضات محافظة (P2/S8):
#   JSON الداخلي 256KB / محادثة AI 1024KB / الإعدادات 64KB / نماذج الدخول 128KB
#   الرسائل (صوت+مرفق base64) بالميغابايت: 16 / رفع multipart بالميغابايت: 25
#   سقف proxy المعلن للمحادثات غير multipart بالميغابايت: 2
# JSON_BODY_LIMIT_KB=256
# AI_CHAT_BODY_LIMIT_KB=1024
# SETTINGS_BODY_LIMIT_KB=64
# FORM_BODY_LIMIT_KB=128
# MESSAGES_BODY_LIMIT_MB=16
# UPLOAD_BODY_LIMIT_MB=25
# PROXY_JSON_DECLARED_LIMIT_MB=2

# حدود المعدل الموزعة (P2/S10) — على PostgreSQL نفسها (تعمل بين النسخ):
#   إعداد الحساب الأول 10/ساعة / الحجز العام 30/15د / تسجيل الوصول 60/15د
#   محادثة AI 30/5د / اختبار اتصال مزود 10/5د
# SETUP_RATE_MAX=10
# SETUP_RATE_WINDOW_MIN=60
# BOOK_RATE_MAX=30
# BOOK_RATE_WINDOW_MIN=15
# CHECKIN_RATE_MAX=60
# CHECKIN_RATE_WINDOW_MIN=15
# AI_CHAT_RATE_MAX=30
# AI_CHAT_RATE_WINDOW_MIN=5
# AI_PROVIDER_TEST_RATE_MAX=10
# AI_PROVIDER_TEST_RATE_WINDOW_MIN=5

# منفذ اختبارات الأمن HTTP المعزولة (P2/S14) — أداة تطوير لا إنتاج.
# SECURITY_HTTP_PORT=3217
