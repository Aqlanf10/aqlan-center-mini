# رابط قاعدة البيانات (Neon أو Railway أو Supabase)
DATABASE_URL=postgresql://user:password@host/dbname

# على Railway يغيّر التطبيق اسم القاعدة تلقائيًا إلى aqlan_center_mini_v2 داخل
# خدمة PostgreSQL التابعة لمشروع Aqlan Center Mini، ولا يلمس قاعدة railway القديمة.

# توقيت العيادة — تعز/اليمن. يُترك كما هو إلا عند تغيير المدينة.
CLINIC_TIME_ZONE=Asia/Aden

# عدد الكراسي واسم المركز وأسعار الصرف تُضبط من شاشة /settings لا من هنا.

# سرّ توقيع الجلسات — 32 حرفًا فأكثر. ولّده بأمر:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# رمز الإعداد الأول — يُستخدم مرة واحدة لإنشاء حساب المدير، ثم احذفه من إعدادات النشر.
SETUP_TOKEN=
