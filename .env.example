# Aqlan Center Mini — example environment variables only.
# Never commit real secrets or production credentials.
# On Railway, set these in the service Variables tab (DATABASE_URL should
# reference the PostgreSQL service variable, e.g. ${{Postgres.DATABASE_URL}}).

# Standard PostgreSQL connection string (Railway PostgreSQL / local dev).
# Everything (host, port, user, password, database) comes from this URL —
# nothing is hard-coded. sslmode in the URL is honored automatically.
DATABASE_URL=
AUTH_SECRET=
NEXT_PUBLIC_APP_NAME=Aqlan Center Mini
NEXT_PUBLIC_APP_TIMEZONE=Asia/Aden

# Optional database tuning (sane defaults when unset).
# DATABASE_SSL=true|false|verify-full   — override SSL detection
# DATABASE_POOL_MAX=10                   — postgres.js pool size

# Optional — public base URL of the deployment (e.g. https://aqlan-center-mini.up.railway.app).
# Recommended in production; omitted by default and derived from each request.
# BETTER_AUTH_URL=http://localhost:3000

# Optional — only needed when seeding the first administrator (npm run db:seed).
# ADMIN_USERNAME=admin
# ADMIN_NAME=System Administrator
# ADMIN_EMAIL=admin@example.com.local
# ADMIN_PASSWORD=change-me-strong-password
