# رابط قاعدة البيانات (Neon أو Railway أو Supabase)
DATABASE_URL=postgresql://user:password@host/dbname
# للتجربة على ذاكرة مؤقتة فقط: USE_LOCAL_DB=true مع npm run dev.
# لا يُسمح بهذا الخيار في الإنتاج؛ بيانات التجربة تزول بإيقاف العملية.
# على Railway يغيّر التطبيق اسم القاعدة تلقائيًا إلى aqlan_center_mini_v2 داخل
# خدمة PostgreSQL التابعة لمشروع Aqlan Center Mini، ولا يلمس قاعدة railway القديمة.

# ── (P1-FIX-8) تصنيف بيئة الهدف — إلزامي لأدوات قاعدة البيانات ────────────────
# db:migrate --apply وrestore:full ترفضان بنيويًّا production وunknown-remote؛
# التصنيف الصريح هو ما يفتح القواعد البعيدة غير الإنتاجية (اختبار/تدريج):
#   test | development | staging | production
# غيابه مع مضيف بعيد = unknown-remote ⇒ رفض أي كتابة حتى يُصنَّف.
# DATABASE_ENVIRONMENT=development

# توقيت العيادة — تعز/اليمن. يُترك كما هو إلا عند تغيير المدينة.
CLINIC_TIME_ZONE=Asia/Aden

# عدد الكراسي واسم المركز وأسعار الصرف تُضبط من شاشة /settings لا من هنا.

# سرّ توقيع الجلسات — 32 حرفًا فأكثر. ولّده بأمر:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# رمز الإعداد الأول — يُستخدم مرة واحدة لإنشاء حساب المدير، ثم احذفه من إعدادات النشر.
SETUP_TOKEN=

# مجلّد الأشعة والمستندات — **يجب أن يكون داخل قرص دائم موثَّق** (P1-FIX-7).
#
# على Railway: أضف Volume إلى الخدمة وركّبه على /data، ثم اضبط:
#   DURABLE_STORAGE_ROOT=/data
#   DOCUMENTS_DIR=/data/documents
# الجاهزية (ready في /api/health) تتطلب في الإنتاج أن يكون DOCUMENTS_DIR داخل
# جذر دائم موثَّق — إما DURABLE_STORAGE_ROOT صريح أو قرص مثبت فعليًّا يظهر في
# /proc/mounts. مسار مطلق «عادي» داخل الحاوية بلا قرص = غير دائم: يُمحى عند
# أول إعادة نشر — ولذلك يُرفض.
#
# محليًّا: ./.data/documents (بلا سياق إنتاج يُقبل المسار المطلق خارج المناطق المؤقّتة)
DOCUMENTS_DIR=
# DURABLE_STORAGE_ROOT=/data

# مفتاح Google Gemini API للذكاء الاصطناعي (احصل عليه من Google AI Studio)
GEMINI_API_KEY=

# ── (P1) تحصين قاعدة البيانات ────────────────────────────────────────────────

# شهادة الجذر للتحقق الكامل من سلسلة شهادة PostgreSQL (P1.19 + P1-FIX-9).
# احصل على شهادة جذر تثق بها (من مزوّد القاعدة أو من مسؤول البنية)، ارفعها
# للخدمة واضبط مسارها هنا — فيتحول الاتصال من «مشفَّر بلا تحقق» إلى «مشفَّر
# ومتحقَّق». ملاحظة صدق: لم نتحقق أن Railway يتيح تنزيل CA من لوحة قاعدة
# PostgreSQL — لا تفترض ذلك؛ وإن جربته فوثّق النتيجة فعلًا.
# سياسة P1: sslmode=disable على مضيف بعيد في سياق إنتاج = رفض فوري (الإقلاع
# يفشل بصوت عالٍ). بلا هذا المتغير يبقى البعيد «مشفَّرًا بلا تحقق» — مخاطرة
# متبقية معلنة مع تحذير مسجَّل عند الإقلاع، لا تُسمّى verified.
# PGSSL_ROOT_CERT=/path/to/ca.pem

# سقف اتصالات الـpool (P1.20) — 1 إلى 20، والافتراضي 3.
# DB_POOL_MAX=3

# ── (P1) اختبارات تكامل PostgreSQL الحقيقية (لا تُضبط في الإنتاج) ────────────
# قاعدة معزولة لأمر npm run test:postgres — لا توجَّه لقاعدة إنتاج أبدًا.
# TEST_DATABASE_URL=postgresql://ci@127.0.0.1:5432/aqlan_p1_test?sslmode=disable
