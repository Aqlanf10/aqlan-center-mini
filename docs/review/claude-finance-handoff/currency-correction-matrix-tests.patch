@@ -0,0 +1,58 @@
+import { beforeEach, describe, expect, it, vi } from "vitest";
+const mocks = vi.hoisted(() => ({ session: vi.fn(), read: vi.fn(), write: vi.fn() }));
+vi.mock("@/lib/session", () => ({ requireSession: mocks.session }));
+vi.mock("@/lib/invoice-revision-db", () => ({ readInvoiceRevision: mocks.read, reviseInvoice: mocks.write }));
+vi.mock("@/lib/debt-installments-db", () => ({ DebtRepaymentError: class extends Error {
+  constructor(public code: string, message: string) { super(message); }
+} }));
+import { POST } from "../app/api/invoices/[id]/correct/route";
+import { DebtRepaymentError } from "../lib/debt-installments-db";
+import { JSON_BODY_LIMIT_BYTES } from "../lib/security-limits";
+const actor = { role: "admin", username: "synthetic-admin", userId: 5 };
+const request = (body = "{}", headers: Record<string, string> = {}) => new Request("http://localhost/api/invoices/12/correct", { method: "POST", body, headers: { "content-type": "application/json", ...headers } });
+const context = (id = "12") => ({ params: Promise.resolve({ id }) });
+beforeEach(() => { vi.resetAllMocks(); mocks.session.mockResolvedValue(actor); });
+describe("existing correction POST authorization and failure boundary", () => {
+  it.each([null, "doctor", "reception", "accountant", "cashier"])("refuses %s before reading the body or invoking mutation", async role => {
+    mocks.session.mockResolvedValue(role ? { ...actor, role } : null);
+    const req = request("not JSON");
+    expect((await POST(req, context())).status).toBe(403);
+    expect(req.bodyUsed).toBe(false);
+    expect(mocks.write).not.toHaveBeenCalled();
+  });
+  it.each(["0", "-1", "NaN", "1.5", "9007199254740992"])("refuses invalid invoice ID %s before mutation", async id => {
+    expect((await POST(request(), context(id))).status).toBe(400);
+    expect(mocks.write).not.toHaveBeenCalled();
+  });
+  it.each(["null", "[]", "1", '"text"', "{"])("rejects malformed/non-object payload %s", async body => {
+    expect((await POST(request(body), context())).status).toBe(400);
+    expect(mocks.write).not.toHaveBeenCalled();
+  });
+  it("rejects declared oversized bodies before mutation", async () => {
+    expect((await POST(request("{}", { "content-length": String(JSON_BODY_LIMIT_BYTES + 1) }), context())).status).toBe(413);
+    expect(mocks.write).not.toHaveBeenCalled();
+  });
+  it.each([["unauthorized", 403], ["missing", 404], ["invalid", 400], ["stale", 409], ["conflict", 409]] as const)("preserves %s refusal status without retrying mutation", async (code, status) => {
+    mocks.write.mockRejectedValue(new DebtRepaymentError(code, "synthetic refusal"));
+    const response = await POST(request(), context());
+    expect(response.status).toBe(status);
+    expect(await response.json()).toEqual({ code, message: "synthetic refusal" });
+    expect(mocks.write).toHaveBeenCalledTimes(1);
+  });
+  it.each([false, true])("passes exact command and actor once, replay=%s", async replayed => {
+    const body = { currency: "SAR", idempotencyKey: "synthetic-operation", reason: "تصحيح العملة" };
+    const acknowledgement = { replayed, currency: "SAR", remainingMinor: 100 };
+    mocks.write.mockResolvedValue(acknowledgement);
+    const response = await POST(request(JSON.stringify(body)), context());
+    expect(response.status).toBe(replayed ? 200 : 201);
+    expect(await response.json()).toEqual(acknowledgement);
+    expect(mocks.write).toHaveBeenCalledExactlyOnceWith(12, body, actor);
+  });
+  it("redacts unexpected storage failures and never retries an uncertain command", async () => {
+    mocks.write.mockRejectedValue(new Error("private-storage-detail"));
+    const response = await POST(request(), context());
+    expect(response.status).toBe(500);
+    expect(await response.text()).not.toContain("private-storage-detail");
+    expect(mocks.write).toHaveBeenCalledTimes(1);
+  });
+});
