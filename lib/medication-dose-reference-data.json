  "warnings": {
    "apap": {
      "text_ar": "افحص جميع مصادر الباراسيتامول؛ خطر سمية الكبد عند التجاوز. مرض الكبد/سوء التغذية/وزن منخفض أو اختلال الكلى يحتاج مراجعة النشرة وتعديلًا مهنيًا لا تلقائيًا.",
      "sources": [
        "SD_ANALGESIC_CAUTION",
        "AAPD25"
      ]
    },
    "nsaid": {
      "text_ar": "منع/مراجعة حساسيةNSAIDs أو ربو محرّض بها، قرحة/نزف، جفاف أو قصوركلوي، مضادات التخثر، NSAIDs أخرى/أسبرين. من20أسبوع حمل يتجنب إلا لضرورة يقررها المختص؛ من30أسبوع يتجنب.",
      "sources": [
        "SD_IBU",
        "FDA_NSAID"
      ]
    },
    "penicillin": {
      "text_ar": "لا عند تفاعل فوري للبنسلين مثل التأق/الشرى؛ قصوركلوي شديد قد يستلزم تعديلًا. تداخلwarfarin يحتاج تدبيرINR، لا بديل حساسية آلي.",
      "sources": [
        "SD_ABX_CAUTION"
      ]
    },
    "metronidazole": {
      "text_ar": "حساسيةnitroimidazole مانع؛ SDCEP يمنع وصفه معwarfarin. تجنب الكحول أثناءه؛ فترة ما بعده حسب نشرةالمنتج. أمراض الكبد/الحمل/الرضاعة تراجع مهنيًا.",
      "sources": [
        "SD_ABX_CAUTION"
      ]
    },
    "coamoxiclav": {
      "text_ar": "الحساسية الخطرة أو تاريخ يرقان ركودي/اختلال كبدي مرتبط به مانع. GFR<30 يستلزم مسارًا آخر؛ قوة875/125 غيرملائمة. النسب والأشكال غيرقابلة للاستبدال التلقائي.",
      "sources": [
        "COAMOX_LABEL"
      ]
    },
    "macrolide": {
      "text_ar": "راجع الحساسية وQT والتداخلات والمرض الكبدي. كلاريثرومايسين يحتاج تعديلًا في القصور الكلوي الشديد ومراجعة منفعة/خطر بالحمل؛ أزيثرومايسين يحتاج حذرًا في مرض الكبد المهم. لا بدائل تلقائية ولا تعديل آلي.",
      "sources": [
        "CLARI_LABEL",
        "AZITH_LABEL"
      ],
      "completeness": "تنبيه بحثي غير مكتمل؛ يمنع تفعيل هذهالملفات قبلتدقيق النشرة"
    },
    "chlorhexidine": {
      "text_ar": "حساسية قدتشمل التأق؛ تغير مذاق/تصبغ قابل للمعالجة؛ افصل عن المعجون الأنيوني حسبالنشرة. لا بلع؛ مرجع0.2% لايبرر منتج0.12%.",
      "sources": [
        "CHX_LABEL"
      ]
    },
    "nystatin": {
      "text_ar": "حساسيةالمادة/السواغات، تحقق منالسكر والتركيز وتعليمات المعلق؛ ليس لعلاج عدوى جهازية.",
      "sources": [
        "NYST_LABEL"
      ]
    },
    "miconazole": {
      "text_ar": "موانع بالنشرة: خلل الكبد، warfarin وبعضstatins وأدويةQT/تداخلاتCYP؛ خطر الاختناق. يفضل تجنبه فيالحمل إلابقرارمنفعة/خطر، والرضاعة تتطلب مراجعة.",
      "sources": [
        "MICO_LABEL"
      ]
    },
    "fluconazole": {
      "text_ar": "راجع الكلى والكبد وQT وتداخلاتCYP؛ SDCEP ينصح بعدمإعطائه معwarfarin أوstatins. الحمل يحتاج مراجعةمتخصصة ولااختيارافتراضي.",
      "sources": [
        "SD_FLUC",
        "FLUC_LABEL"
      ]
    },
    "benzydamine": {
      "text_ar": "حساسيةالمنتج؛ تحقق منالسواغات والكحول، لا يستخدمغسول≤12سنة، لايبلع؛ الحمل/الرضاعة حسبالنشرة. لا يُنصح به عند فرط الحساسية للأسبرين أو مضادات الالتهاب غير الستيرويدية، ويستلزم الحذر عند وجود ربو حالي أو سابق.",
      "sources": [
        "BENZ_LABEL"
      ]
